# Shopify app credentials (Dev Dashboard → app → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-04

# The store (used by background jobs to resolve the offline token)
SHOP=cinegearpro.myshopify.com

# Public URL of this app (Railway URL) — used for webhook callbacks
APP_URL=

# Shopify Admin URL handle used for adjustment and notification links
SHOPIFY_APP_HANDLE=stock-track-cgp

# Lark group custom bot. Leave blank to keep notifications disabled.
# The optional secret is only needed when the bot's signature security is enabled.
LARK_ADJUSTMENT_WEBHOOK_URL=
LARK_ADJUSTMENT_WEBHOOK_SECRET=

# Postgres (Railway injects DATABASE_URL automatically when linked)
DATABASE_URL=

# Where to persist adjustment attachments (mount a Railway volume here).
# Offline tokens are encrypted in Postgres and only cached here.
DATA_DIR=/data

# Daily snapshot hour (UTC)
SNAPSHOT_HOUR=3

# ShopifyQL inventory history pacing (milliseconds; 16s stays below the
# observed 1,000-point/minute reporting limit)
SHOPIFYQL_PACE_MS=16000
